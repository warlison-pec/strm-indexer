# Para habilitar consulta autenticada de URL no endpoint /source.
# Gere um segredo forte localmente e coloque em .env:
# INDEXER_TOKEN=...
INDEXER_TOKEN=

# Servidores da SUA rede liberados como fonte de guia (EPG), ex.: um gerador de EPG em Docker.
# Qualquer outro endereço interno continua bloqueado por segurança. Separe por vírgula.
# INDEXER_TRUSTED_HOSTS=192.168.1.16:3001
INDEXER_TRUSTED_HOSTS=

# Arquivos do Docker Compose usados juntos (sem isso, "docker compose up" sobe só o principal)
COMPOSE_FILE=docker-compose.yml:docker-compose.v03.yml:docker-compose.storage.yml:docker-compose.v05.yml:docker-compose.v07.yml:docker-compose.v083.yml:docker-compose.v085.yml
